---
import Layout from '../layouts/Layout.astro';
import { 
  Phone, 
  MapPin, 
  Clock, 
  Send, 
  Mail, 
  ShieldCheck, 
  Truck, 
  Globe
} from '@lucide/astro';
---

<Layout 
  title="Contact Us - Roxstar Performance Exhausts & Parts" 
  description="Contact Roxstar Performance for obligation-free advice on exhausts and parts. Located in Cape Town with fast delivery across South Africa."
>

  <!-- Contact Hero Section -->
  <section class="relative pt-32 pb-16 bg-zinc-950 overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1f1f23_1px,transparent_1px),linear-gradient(to_bottom,#1f1f23_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30"></div>
    <div class="absolute top-0 left-1/3 w-[450px] h-[450px] rounded-full bg-red-600/5 blur-[120px] pointer-events-none"></div>
    
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-white uppercase max-w-3xl mx-auto">
        Contact Us for Custom Performance <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-amber-500">Exhausts and Parts</span>
      </h1>
      <p class="mt-6 text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        Contact us anytime for an obligation-free discussion regarding your needs. **We know what works!**
      </p>
    </div>
  </section>

  <!-- Interactive Contact Hub -->
  <section class="py-16 bg-zinc-950 border-t border-zinc-900" id="quote">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left Side: Contact Cards Grid & Shipping info -->
        <div class="lg:col-span-5 flex flex-col gap-8">
          
          <div>
            <h2 class="text-2xl font-extrabold text-zinc-100 tracking-tight mb-2">Get In Touch Directly</h2>
            <p class="text-sm text-zinc-400 leading-relaxed">
              We look forward to helping you extract the absolute best performance, style, and acoustic profile from your bike.
            </p>
          </div>

          <!-- Cards Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            
            <!-- Phone Card -->
            <a href="tel:0825723914" class="group p-5 bg-zinc-900/30 border border-zinc-900 hover:border-red-500/20 rounded-xl transition-all flex flex-col justify-between">
              <div class="w-10 h-10 rounded-lg bg-red-600/10 text-red-500 flex items-center justify-center mb-4 group-hover:bg-red-600 group-hover:text-white transition-all">
                <Phone class="w-5 h-5" />
              </div>
              <div>
                <p class="text-xs text-zinc-500 uppercase font-bold tracking-wider mb-1">Call Expert</p>
                <p class="text-base font-bold text-zinc-100 group-hover:text-red-500 transition-colors">082 572 3914</p>
                <p class="text-[10px] text-zinc-500 mt-1 leading-normal">Obligation-free consultations</p>
              </div>
            </a>

            <!-- Location Card -->
            <div class="p-5 bg-zinc-900/30 border border-zinc-900 rounded-xl flex flex-col justify-between">
              <div class="w-10 h-10 rounded-lg bg-red-600/10 text-red-500 flex items-center justify-center mb-4">
                <MapPin class="w-5 h-5" />
              </div>
              <div>
                <p class="text-xs text-zinc-500 uppercase font-bold tracking-wider mb-1">HQ Location</p>
                <p class="text-base font-bold text-zinc-100">Cape Town, SA</p>
                <p class="text-[10px] text-zinc-500 mt-1 leading-normal">Nationwide & worldwide dispatch</p>
              </div>
            </div>

            <!-- Shipping Logistics Support -->
            <div class="p-5 bg-zinc-900/30 border border-zinc-900 rounded-xl flex flex-col justify-between col-span-1 sm:col-span-2">
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-red-600/10 text-red-500 flex items-center justify-center shrink-0">
                  <Truck class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="text-sm font-bold text-zinc-200">Nationwide Delivery</h3>
                  <p class="text-xs text-zinc-400 mt-1 leading-relaxed">
                    We ship directly to physical addresses or registered motorcycle fitment workshops across all 9 provinces. Delivery takes 2 to 5 business days for in-stock items.
                  </p>
                </div>
              </div>
              <div class="flex gap-4 border-t border-zinc-900/60 pt-4 mt-4">
                <div class="w-10 h-10 rounded-lg bg-red-600/10 text-red-500 flex items-center justify-center shrink-0">
                  <Globe class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="text-sm font-bold text-zinc-200">Worldwide Shipping</h3>
                  <p class="text-xs text-zinc-400 mt-1 leading-relaxed">
                    Global logistics support is available for international orders. Shipping rates and transit schedules calculated per region.
                  </p>
                </div>
              </div>
            </div>
            
          </div>

        </div>

        <!-- Right Side: Contact Form -->
        <div class="lg:col-span-7">
          <div class="bg-zinc-900/20 border border-zinc-900 rounded-2xl p-6 sm:p-8 relative">
            <h3 class="text-xl font-bold text-white mb-2">Request Quote or Advice</h3>
            <p class="text-xs text-zinc-400 mb-6">Complete this inquiry form and our performance expert will review and get back to you.</p>

            <form action="https://formspree.io/f/placeholder" method="POST" class="space-y-5">
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Name Input -->
                <div class="flex flex-col gap-1.5">
                  <label for="name" class="text-xs font-semibold text-zinc-400">Full Name</label>
                  <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    required 
                    placeholder="e.g. John Doe"
                    class="w-full rounded-lg bg-zinc-950 border border-zinc-800 focus:border-red-500 focus:ring-1 focus:ring-red-500 text-sm text-zinc-100 p-3 outline-none transition-colors"
                  />
                </div>
                
                <!-- Email Input -->
                <div class="flex flex-col gap-1.5">
                  <label for="email" class="text-xs font-semibold text-zinc-400">Email Address</label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    required 
                    placeholder="name@domain.co.za"
                    class="w-full rounded-lg bg-zinc-950 border border-zinc-800 focus:border-red-500 focus:ring-1 focus:ring-red-500 text-sm text-zinc-100 p-3 outline-none transition-colors"
                  />
                </div>
              </div>

              <!-- Phone Number Input -->
              <div class="flex flex-col gap-1.5">
                <label for="phone" class="text-xs font-semibold text-zinc-400">Phone Number (Optional)</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  placeholder="e.g. 082 572 3914"
                  class="w-full rounded-lg bg-zinc-950 border border-zinc-800 focus:border-red-500 focus:ring-1 focus:ring-red-500 text-sm text-zinc-100 p-3 outline-none transition-colors"
                />
              </div>

              <!-- Bike Make/Model Input -->
              <div class="flex flex-col gap-1.5">
                <label for="bike" class="text-xs font-semibold text-zinc-400">Motorcycle Make, Model & Year</label>
                <input 
                  type="text" 
                  id="bike" 
                  name="bike" 
                  required
                  placeholder="e.g. BMW R 1250 GS (2021) / Harley Street Glide (2019)"
                  class="w-full rounded-lg bg-zinc-950 border border-zinc-800 focus:border-red-500 focus:ring-1 focus:ring-red-500 text-sm text-zinc-100 p-3 outline-none transition-colors"
                />
              </div>

              <!-- Message Input -->
              <div class="flex flex-col gap-1.5">
                <label for="message" class="text-xs font-semibold text-zinc-400">Your Inquiry or Power Goals</label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="4" 
                  required
                  placeholder="Specify what upgrades you are interested in (Slip-On, Full System, ECU tuner) or describe your performance objectives..."
                  class="w-full rounded-lg bg-zinc-950 border border-zinc-800 focus:border-red-500 focus:ring-1 focus:ring-red-500 text-sm text-zinc-100 p-3 outline-none transition-colors resize-none"
                ></textarea>
              </div>

              <!-- Submit Button -->
              <button 
                type="submit" 
                class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 py-3.5 text-sm font-bold text-white shadow-lg shadow-red-950/40 transition-colors uppercase tracking-wider cursor-pointer"
              >
                <Send class="w-4 h-4" /> Send Inquiry
              </button>

            </form>
          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>
