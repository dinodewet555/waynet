      </div>

      <!-- Clean Grid Matrix -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {[
          { name: "Vance & Hines", highlight: "Harley & Cruiser Specialist" },
          { name: "Scorpion", highlight: "Red Power UK Engineering" },
          { name: "Dominator SA", highlight: "Official Distributor" },
          { name: "Brock's Performance", highlight: "USA Drag & Sportbike Power" },
          { name: "Bassani", highlight: "Premium V-Twin Pipes" },
          { name: "Cobra USA", highlight: "Metric & Cruiser Systems" },
          { name: "Rinehart Racing", highlight: "Sound for V-Twins" },
          { name: "S&S Cycle", highlight: "Proven Performance Parts" },
          { name: "K&N Filters", highlight: "High-Flow Air Intake" },
          { name: "ThunderMax", highlight: "Advanced Closed-Loop EFI" }
        ].map((brand) => (
          <div class="flex flex-col justify-center items-center p-6 bg-zinc-900/30 border border-zinc-900 rounded-xl hover:border-zinc-800 text-center transition-all duration-300">
            <span class="text-base font-extrabold text-zinc-100 tracking-wide">{brand.name}</span>
            <span class="text-[10px] text-zinc-500 mt-1 uppercase tracking-wider font-semibold">{brand.highlight}</span>
