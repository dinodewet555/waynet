            Learn More <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
          </div>
        </div>

        <!-- Style 4 -->
        <div class="group relative rounded-xl border border-zinc-900 bg-zinc-950 p-6 transition-all duration-300 hover:border-zinc-800 hover:-translate-y-1 hover:shadow-xl hover:shadow-red-950/10 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-red-600/10 text-red-500 flex items-center justify-center mb-5 group-hover:bg-red-600 group-hover:text-white transition-all">
              <Flame class="w-5 h-5" />
            </div>
            <h3 class="font-bold text-zinc-100 text-lg mb-2">Drag Racing</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">Max-torque exhausts, lowering kits, quick shifters, launch control modules, and structural weight reductions.</p>
          </div>
          <div class="mt-6 text-xs text-red-500 font-semibold group-hover:text-red-400 transition-colors flex items-center gap-1">
            Learn More <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
