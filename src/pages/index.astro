      <div class="mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="tel:0825723914" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 rounded-full bg-red-600 hover:bg-red-700 px-8 py-4 text-base font-bold text-white shadow-lg shadow-red-950/50 hover:shadow-red-950/80 transition-all uppercase tracking-wide">
