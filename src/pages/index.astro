          <div>
            <div class="flex justify-between items-start mb-6">
              <div>
                <h3 class="text-xl font-bold text-white">Full Exhaust Systems</h3>
                <p class="text-sm text-zinc-400 mt-1">Headers to Silencer Replacement</p>
              </div>
              <span class="px-3 py-1 rounded bg-red-950/20 border border-red-500/30 text-xs font-semibold text-red-400">Track-Spec</span>
            </div>
            
            <ul class="space-y-4 mb-8">
              <li class="flex items-start gap-3">
                <CheckCircle2 class="w-5 h-5 text-red-500 shrink-0 mt-0.5" />
                <div>
                  <strong class="text-zinc-200 block text-sm">Horsepower & Torque</strong>
                  <p class="text-xs text-zinc-400 mt-0.5">Delivers a massive 5-15% increase in total horsepower and high-end pull.</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
