---
import Layout from '../layouts/Layout.astro';
import { 
  Phone, 
  ArrowRight, 
  Award, 
  Truck, 
  ShieldCheck, 
  Users, 
  Compass, 
  Zap, 
  Map, 
  Flame, 
  Activity,
  CheckCircle2,
  AlertTriangle,
  HelpCircle,
  ChevronDown
} from '@lucide/astro';

// Structured FAQ Content for SEO validation
const faqs = [
  {
    q: "How much horsepower and torque can I expect to gain?",
    a: "Depending on your motorcycle's make, model, and the selected exhaust system, you can expect power optimizations between 5% and 15%. A full system paired with a dedicated ECU tuner (like ThunderMax) will maximize these gains, particularly in low-to-mid range torque."
  },
  {
    q: "What is the difference between a slip-on exhaust and a full system?",
    a: "A Slip-On exhaust replaces only the muffler section of your stock exhaust, retaining your factory headers. It is a cost-effective way to shed 2-3 kg, improve sound quality, and get subtle power gains. A Full System replaces everything from the engine headers to the muffler, maximizing horsepower gains (up to 15%) and reducing weight by 5-7 kg, but typically requires ECU tuning to ensure optimal fuel-to-air ratios."
  },
  {
    q: "Do I need to tune my ECU after installing a new exhaust?",
    a: "For most slip-on exhausts, ECU tuning is optional but beneficial. For full exhaust systems, ECU tuning is highly recommended to prevent the engine from running too lean (which can cause overheating or engine damage). Pairing a full system with a premium fuel controller like ThunderMax or Brock's flashing kits ensures safe, reliable, and maximized power delivery."
  },
  {
    q: "Are aftermarket exhausts legal on South African roads?",
    a: "South African road regulations require exhausts to remain within designated decibel levels and prevent emission hazards. Many of our premium brands offer systems with removable DB killers (silencer inserts) which keep sound levels within reasonable limits for daily road use, while allowing the option to remove them for track days."
  },
  {
    q: "How long does shipping take and is nationwide delivery available?",
    a: "Yes, we offer reliable nationwide delivery across South Africa, shipping straight to your door or your preferred local dealership. Thanks to our streamlined supply chain, we cut down traditional multi-month dealer wait times to just 2 to 5 business days for in-stock items. Worldwide shipping is also supported."
  }
];
---

<Layout 
  title="Premium Motorcycle Exhausts & Performance Parts South Africa" 
  description="Unlock raw power and cut weight since 2007. Official SA distributor for Dominator Exhausts, Brock's, Vance & Hines, Scorpion, Bassani, and more. Nationwide shipping."
>
  
  <!-- 1. Hero Section -->
