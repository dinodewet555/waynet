    </div>
  </section>

  <!-- 5. Technical Benefits Breakdown (Slip-On vs Full System) -->
  <section class="py-24 bg-zinc-900/30 border-t border-zinc-900 relative">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">Technical Benefits Breakdown</h2>
        <p class="mt-4 text-zinc-400">Understanding what type of upgrade aligns with your power goals, budget, and bike setup.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <!-- Comparison Card 1: Slip-On -->
        <div class="bg-zinc-950 border border-zinc-900 rounded-2xl p-8 relative flex flex-col justify-between">
          <div>
            <div class="flex justify-between items-start mb-6">
              <div>
