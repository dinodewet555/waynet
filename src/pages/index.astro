          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Brands Showroom -->
  <section id="brands" class="py-24 bg-zinc-950 border-t border-zinc-900 relative">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <!-- Dominator Featured Banner -->
      <div class="relative overflow-hidden rounded-3xl border border-red-500/20 bg-zinc-900/30 p-8 md:p-12 mb-16">
        <div class="absolute inset-0 bg-gradient-to-r from-red-600/5 to-transparent pointer-events-none"></div>
